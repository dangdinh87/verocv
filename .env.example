# Cloudflare D1 HTTP REST API & Workers AI (dùng khi chạy Next.js trên Node/Vercel hoặc local dev)
# Khi deploy trực tiếp lên Cloudflare Workers, runtime sẽ tự gắn binding env.DB và env.AI trong wrangler.jsonc.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Bảo mật phiên đăng nhập (khuyến nghị chuỗi ngẫu nhiên >= 32 ký tự ở production)
SESSION_SECRET=

# Cấu hình VietQR (Napas247 + Webhook SePay / PayOS / Casso)
VIETQR_BANK_BIN=970422
VIETQR_BANK_SHORT_NAME=MBBank
VIETQR_ACCOUNT_NO=0123456789
VIETQR_ACCOUNT_NAME=VEROCV SAAS
VIETQR_WEBHOOK_SECRET=
